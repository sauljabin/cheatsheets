# To install SDKMAN on macOS or Linux with Bash:
curl -s "https://get.sdkman.io" | bash

# To load SDKMAN without restarting the shell:
source "$HOME/.sdkman/bin/sdkman-init.sh"

# To verify SDKMAN:
sdk version

# To list available SDKs:
sdk list

# To list available versions of an SDK:
sdk list <sdk>

# To show currently selected SDK versions:
sdk current

# To install an SDK version:
sdk install <sdk> <version>

# To use an SDK version in the current shell:
sdk use <sdk> <version>

# To set the default SDK version:
sdk default <sdk> <version>
