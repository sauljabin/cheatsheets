# To amend the author from a commit onward (rewrites history):
git rebase -i <commit>^ --exec "git commit --amend --reset-author -C HEAD"

# To find a file in history by a path fragment:
git log --all --full-history --patch -- '**/*<keyword>*'

# To restore a file deleted by a commit:
git restore --source=<deleting-commit>^ -- <file-path>
