# To install Docker Desktop with Homebrew on macOS:
brew install --cask docker-desktop

# To install only the Docker CLI with Homebrew on macOS or Linux:
brew install docker

# To remove all images (destructive):
docker rmi -f $(docker images -aq)

# To remove all volumes (destructive):
docker volume rm $(docker volume ls -q)

# To stop all containers:
docker stop $(docker ps -aq)

# To remove all stopped containers (destructive):
docker rm -f $(docker ps -aq)

# To prune the whole system, including unused volumes (destructive):
docker system prune -af --volumes

# To start a container with volume and variable:
docker run -d -p <host-port>:<container-port> -e <variable-key>=<variable-value> -v <host-path>:<container-path> <image-name>

# To remove dangling images:
docker rmi -f $(docker images -f "dangling=true" -q)
